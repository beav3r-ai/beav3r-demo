# Shared
BEAV3R_API_KEY=replace-with-your-beav3r-api-key
# API server URL (not dashboard URL)
BEAV3R_BASE_URL=https://staging.server.beav3r.ai
BEAV3R_AGENT_ID=sdk_demo
BEAV3R_DEFAULT_EXPIRY_SECONDS=180

# Offchain demo (index.mjs)
# Required: BEAV3R_API_KEY
# Key verification is discovered at runtime from:
# GET /.well-known/execution-authorization-keys

# Onchain demo (onchain-example.mjs)
# Required for keeper flow:
BEAV3R_PROJECT_ID=project_xxx
ONCHAIN_RPC_URL=https://base-sepolia.infura.io/v3/your-key
ONCHAIN_CHAIN_ID=84532
ONCHAIN_PRIVATE_KEY=0xyour-funded-base-sepolia-key
ONCHAIN_ACTOR_ACCOUNT=0xactor-account
ONCHAIN_EXECUTOR_ADDRESS=0xexecutor-contract
ONCHAIN_TOKEN_ADDRESS=0xusdt-contract
ONCHAIN_TOKEN_DECIMALS=6
ONCHAIN_RECIPIENT=0xrecipient
ONCHAIN_AMOUNT=50
ONCHAIN_REASON=onchain demo transfer
ONCHAIN_GAS_LIMIT=500000
ONCHAIN_KEEPER_ADDRESS=0xyour-token-keeper

# Optional timing overrides
# BEAV3R_POLL_INTERVAL_MS=2000
# BEAV3R_TIMEOUT_MS=300000
# ONCHAIN_NONCE=1778081063
# ONCHAIN_EXPIRES_AT=1778082263
